# Data storage
DATA_DIR=/opt/dota-lakehouse/data/storage

# Airflow
AIRFLOW_UID=50000
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=change_me_airflow_db_password
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password
AIRFLOW_SECRET=change_me_airflow_secret_key
FERNET_KEY=change_me_base64_fernet_key_32_bytes=

# MongoDB
MONGO_USER=dota
MONGO_PASSWORD=change_me_mongo_password
MONGO_DB=dota_events
MONGO_PORT=27017
MONGO_HOST=mongo

# PostgreSQL
PG_USER=dota
PG_PASSWORD=change_me_postgres_password
PG_DB=dota
PG_HOST=postgres
PG_PORT=5432

# RustFS (S3 API)
S3_ACCESS_KEY=dota-lakehouse
S3_SECRET_KEY=change_me_s3_secret_key
S3_REGION=us-east-1
S3_BUCKET=dota-lakehouse

# Superset
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin_password
SUPERSET_SECRET_KEY=change_me_superset_secret_key

# Marquez
MARQUEZ_DB_HOST=postgres
MARQUEZ_DB_PORT=5432
MARQUEZ_DB_NAME=marquez
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=change_me_postgres_password
MARQUEZ_URL=http://marquez:5000

OPENLINEAGE_NAMESPACE=dota-lakehouse

LOG_LEVEL=INFO

CASE03_LOAD_MODE=incremental

POSTGRES_URL=postgres://dota:change_me_postgres_password@postgres:5432/dota
MONGO_URL=mongodb://dota:change_me_mongo_password@mongo:27017
MATCHES=1000
SEED=154

SUPERSET_URL=http://dota-superset:8088
SUPERSET_ADMIN_USER=admin

TRINO_HOST=dota-trino
TRINO_PORT=8080
