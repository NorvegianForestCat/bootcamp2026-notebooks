DATA_DIR=/opt/dota-lakehouse/data/storage

# Airflow
AIRFLOW_UID=50000
AIRFLOW_USER=
AIRFLOW_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_SECRET=
FERNET_KEY=

# MongoDB
MONGO_USER=dota
